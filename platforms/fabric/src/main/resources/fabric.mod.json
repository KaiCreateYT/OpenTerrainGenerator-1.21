{
  "schemaVersion": 1,
  "id": "otg",
  "version": "${version}",

  "name": "OpenTerrainGenerator",
  "description": "OTG: Generate anything!",
  "authors": [
    "Team OTG"
  ],
  "contact": {
    "homepage": "https://discord.gg/UXzdVTH",
    "sources": "https://github.com/PG85/OpenTerrainGenerator",
    "issues": "https://github.com/PG85/OpenTerrainGenerator/issues"
  },

  "license": "MIT",
  "icon": "OTGlogo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.pg85.otg.fabric.OTGPlugin"
    ],
    "cardinal-components-entity": [
      "com.pg85.otg.fabric.portals.components.OTGComponents"
    ]
  },
  "mixins": [
    "otg-fabric.mixins.json"
  ],

  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "java": ">=21",
    "cardinal-components-entity": ">=6.1.3"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "cardinal-components": [
      "otg:otg_player"
    ]
  }
}
